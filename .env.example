# ==============================================================================
# AI-Powered Website Link Analysis API - Environment Configuration
# Copy this file to .env and fill in your API credentials. Never commit .env!
# ==============================================================================

# Active LLM provider: "gemini" | "openai" | "anthropic"
LLM_PROVIDER=gemini

# Primary model for the selected provider
# Recommended defaults:
#   gemini    -> gemini-3.1-flash-lite (fastest & lowest cost) or gemini-3.5-flash-lite
#   openai    -> gpt-4o-mini (or gpt-4.1-mini)
#   anthropic -> claude-haiku-4-5-20251001
LLM_MODEL=gemini-3.1-flash-lite

# Optional fallback provider & model if the primary provider fails or rate-limits
FALLBACK_LLM_PROVIDER=
FALLBACK_LLM_MODEL=

# API Keys (set the key for your chosen provider and optional fallback)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Website Extraction & Safety Limits
REQUEST_TIMEOUT_SECONDS=15.0
MAX_RESPONSE_BYTES=2097152
MAX_CONTENT_CHARS=6500
MAX_REDIRECTS=5
FETCH_SECONDARY_PAGES=true

# LLM Settings
LLM_TIMEOUT_SECONDS=45.0
LLM_TEMPERATURE=0.2
LLM_MAX_RETRIES=2
GEMINI_THINKING_LEVEL=MINIMAL

# In-Memory TTL Cache (seconds; set to 0 to disable)
CACHE_TTL_SECONDS=3600
CACHE_MAX_SIZE=256

# Server & Logging
APP_ENV=development
LOG_LEVEL=INFO
